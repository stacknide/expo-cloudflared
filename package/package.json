{
  "name": "expo-cloudflared",
  "version": "4.2.1",
  "description": "Cloudflare Tunnel for Expo — a drop-in replacement for `@expo/ngrok`. Powers `expo start --tunnel` using Cloudflare Tunnel instead of ngrok.",
  "source": "src/index.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.mts",
        "default": "./dist/internal.mjs"
      },
      "require": {
        "types": "./dist/internal.d.ts",
        "default": "./dist/internal.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": "./dist/cli.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev:tsc": "tsc -w -p tsc.tsconfig.json",
    "dev": "NODE_ENV=development tsup",
    "build": "tsup",
    "lint:tsc": "tsc --noEmit",
    "lint:biome": "biome check ./src",
    "lint": "yarn lint:tsc && yarn lint:biome",
    "format": "biome check --write ./src",
    "prepublishOnly": "node ./scripts/assert-ngrok-range.mjs && yarn build"
  },
  "author": "Ashutosh Khanduala <https://github.com/ashuvssut>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stacknide/expo-cloudflared.git",
    "directory": "package"
  },
  "bugs": {
    "url": "https://github.com/stacknide/expo-cloudflared/issues"
  },
  "homepage": "https://github.com/stacknide/expo-cloudflared/tree/main/package#readme",
  "keywords": [
    "expo",
    "ngrok",
    "cloudflared",
    "cloudflare",
    "tunnel",
    "localhost",
    "tunneling",
    "expo-start-tunnel"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@types/node": "^22.10.0",
    "lefthook": "^2.1.1",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3"
  }
}
