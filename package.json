{
  "private": true,
  "name": "expo-cloudflared-workspace",
  "version": "1.0.0",
  "scripts": {
    "publish": "yarn changeset publish",
    "bump": "yarn changeset",
    "dev": "yarn workspace expo-cloudflared dev",
    "build": "yarn workspace expo-cloudflared build",
    "test": "yarn build && yarn test:only",
    "test:only": "yarn workspace expo-cloudflared-test test",
    "demo:tunnel": "yarn build && yarn workspace demo-app start --tunnel",
    "demo:tunnel:dev": "concurrently \"yarn dev\" \"yarn workspace demo-app start --tunnel\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@changesets/cli": "^2.29.8",
    "concurrently": "^9.2.1",
    "lefthook": "^2.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "author": "Ashutosh Khanduala <https://github.com/ashuvssut>",
  "license": "MIT",
  "workspaces": [
    "package",
    "test",
    "test/demo-app"
  ],
  "packageManager": "yarn@4.12.0"
}
