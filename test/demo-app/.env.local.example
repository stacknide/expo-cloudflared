# expo-cloudflared named-tunnel configuration (optional)
#
# Copy this file to .env.local to give `expo start --tunnel` a STABLE URL
# instead of a random trycloudflare.com one. Expo CLI loads .env.local into
# process.env before the tunnel starts, so no code changes are needed.
#
# Without any of these set, a free quick tunnel is used (no account needed).

# ── Name mode (recommended) ──────────────────────────────────────────────────
# One-time setup: npx expo-cloudflared setup
# (runs `cloudflared tunnel login`, creates the tunnel, routes the DNS)
# Name mode follows the actual dev-server port automatically.
#CLOUDFLARED_TUNNEL_NAME=my-expo-tunnel
#CLOUDFLARED_TUNNEL_HOSTNAME=dev.yourdomain.com

# ── Token mode (dashboard-managed) ───────────────────────────────────────────
# Get a token from the Cloudflare Zero Trust dashboard or
# `cloudflared tunnel token <name>`. NOTE: ingress (which local port the
# hostname points at) is fixed in the dashboard — prefer name mode for Expo.
#CLOUDFLARED_TUNNEL_TOKEN=eyJ...
#CLOUDFLARED_TUNNEL_HOSTNAME=dev.yourdomain.com
